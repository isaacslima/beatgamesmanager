rules_version = '2';

// O app acessa o Firestore direto do navegador. Estas regras garantem que:
// - cada usuário só lê e grava em users/{uid} (os próprios dados);
// - todo documento gravado tem o formato esperado (campos permitidos, tipos e tamanhos).
// Checagens que precisam de consultas (nome duplicado, referências, "em uso") ficam no app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Campos opcionais: ausentes, null ou no formato certo.
    function optionalText(data, field, max) {
      return !(field in data) || data[field] == null || text(data[field], 0, max);
    }

    function optionalId(data, field) {
      return !(field in data) || data[field] == null || text(data[field], 1, 128);
    }

    function optionalDate(data, field) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function optionalInt(data, field, min, max) {
      return !(field in data) || data[field] == null
        || (data[field] is int && data[field] >= min && data[field] <= max);
    }

    function hasTimestamps(data) {
      return data.createdAt is string && data.updatedAt is string;
    }

    function validUser(data) {
      return data.keys().hasOnly(['defaultsVersion', 'defaultsSeededAt'])
        && optionalInt(data, 'defaultsVersion', 0, 1000)
        && optionalText(data, 'defaultsSeededAt', 40);
    }

    function validGame(data) {
      return data.keys().hasOnly([
          'title', 'platformId', 'genreId', 'typeId', 'status', 'startDate', 'endDate',
          'playTimeSeconds', 'score', 'difficultyId', 'completionCondition', 'isGoty', 'notes',
          'tagIds', 'createdAt', 'updatedAt'
        ])
        && text(data.title, 1, 200)
        && text(data.status, 1, 128)
        && optionalId(data, 'platformId')
        && optionalId(data, 'genreId')
        && optionalId(data, 'typeId')
        && optionalId(data, 'difficultyId')
        && optionalDate(data, 'startDate')
        && optionalDate(data, 'endDate')
        && (data.get('startDate', null) == null || data.get('endDate', null) == null || data.endDate >= data.startDate)
        && optionalInt(data, 'playTimeSeconds', 0, 360000000)
        && optionalInt(data, 'score', 1, 11)
        && optionalText(data, 'completionCondition', 300)
        && optionalText(data, 'notes', 2000)
        && (!('isGoty' in data) || data.isGoty is bool)
        && (!('tagIds' in data) || (data.tagIds is list && data.tagIds.size() <= 20))
        && hasTimestamps(data);
    }

    function validPlatform(data) {
      return data.keys().hasOnly(['name', 'imageUrl', 'createdAt', 'updatedAt'])
        && text(data.name, 1, 80)
        && (!('imageUrl' in data) || data.imageUrl == null
          || (text(data.imageUrl, 1, 1000) && data.imageUrl.matches('^https://.+')))
        && hasTimestamps(data);
    }

    function validGenre(data) {
      return data.keys().hasOnly(['name', 'description', 'createdAt', 'updatedAt'])
        && text(data.name, 1, 80)
        && optionalText(data, 'description', 500)
        && hasTimestamps(data);
    }

    function validType(data) {
      return data.keys().hasOnly(['name', 'genreId', 'description', 'createdAt', 'updatedAt'])
        && text(data.name, 1, 80)
        && optionalId(data, 'genreId')
        && optionalText(data, 'description', 500)
        && hasTimestamps(data);
    }

    function validTag(data) {
      return data.keys().hasOnly(['name', 'icon', 'color', 'description', 'createdAt', 'updatedAt'])
        && text(data.name, 1, 40)
        && text(data.icon, 1, 40) && data.icon.matches('^[a-z0-9-]+$')
        && data.color in ['purple', 'blue', 'cyan', 'emerald', 'amber', 'orange', 'red', 'pink', 'gray']
        && optionalText(data, 'description', 500)
        && hasTimestamps(data);
    }

    function validStatus(data) {
      return data.keys().hasOnly(['name', 'color', 'order', 'description', 'createdAt', 'updatedAt'])
        && text(data.name, 1, 80)
        && data.color in ['purple', 'blue', 'cyan', 'emerald', 'amber', 'orange', 'red', 'pink', 'gray']
        && data.order is int && data.order >= 0
        && optionalText(data, 'description', 500)
        && hasTimestamps(data);
    }

    // O id da nota é o próprio valor ("11"), então o valor não muda numa edição.
    function validScore(id, data) {
      return data.keys().hasOnly(['value', 'label', 'description', 'createdAt', 'updatedAt'])
        && data.value is int && data.value >= 1 && data.value <= 11
        && id == string(data.value)
        && text(data.label, 1, 60)
        && optionalText(data, 'description', 500)
        && hasTimestamps(data);
    }

    function validDifficulty(data) {
      return data.keys().hasOnly(['key', 'label', 'order', 'description', 'createdAt', 'updatedAt'])
        && text(data.key, 1, 10)
        && text(data.label, 1, 60)
        && data.order is int && data.order >= 0
        && optionalText(data, 'description', 500)
        && hasTimestamps(data);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);

      match /games/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGame(request.resource.data);
      }

      match /platforms/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPlatform(request.resource.data);
      }

      match /genres/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGenre(request.resource.data);
      }

      match /types/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validType(request.resource.data);
      }

      match /tags/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTag(request.resource.data);
      }

      match /statuses/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validStatus(request.resource.data);
        // "wishlist" e "completed" alimentam os cards do dashboard.
        allow delete: if isOwner(uid) && !(id in ['wishlist', 'completed']);
      }

      match /scores/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validScore(id, request.resource.data);
      }

      match /difficulties/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDifficulty(request.resource.data);
      }
    }
  }
}
