{
  "name": "beatgamesmanager",
  "version": "1.0.0",
  "description": "Gerenciador de jogos para zerar com integração de busca externa",
  "main": "src/functions.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "dev": "node --env-file-if-exists=.env.local --watch src/server.js",
    "test": "node --test",
    "deploy": "firebase deploy",
    "firebase:login": "firebase login",
    "deploy:hosting": "firebase deploy --only hosting",
    "emulators": "firebase emulators:start --only functions,hosting"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/isaacslima/beatgamesmanager"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "firebase-tools": "~15.32.1"
  }
}
