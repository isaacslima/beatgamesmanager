{
  "name": "beatgamesmanager",
  "version": "1.0.0",
  "description": "Gerenciador de jogos para zerar com integração de busca externa",
  "main": "server/dev.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server/dev.js",
    "dev": "node --env-file-if-exists=.env.local --watch server/dev.js",
    "test": "node --test",
    "deploy": "firebase deploy",
    "firebase:login": "firebase login",
    "deploy:hosting": "firebase deploy --only hosting",
    "emulators": "firebase emulators:start --only hosting",
    "test:rules": "firebase emulators:exec --only firestore --project demo-beatgames-rules \"node --test rules-tests/firestore-rules.mjs\"",
    "build:icons": "node scripts/build-icons.mjs",
    "build:css": "tailwindcss -i styles/app.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i styles/app.css -o public/css/app.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/isaacslima/beatgamesmanager"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "busboy": "^1.6.0",
    "jose": "~6.2.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-tools": "~15.32.1",
    "flowbite": "^3.1.2",
    "lucide-static": "^1.49.0",
    "tailwindcss": "^4.3.3"
  }
}
